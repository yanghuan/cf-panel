# cf-panel agent systemd 服务模板（推荐使用 Rust 版）
# 用法：
#   1. 下载/构建 Rust agent 并放到 /opt/cf-panel-agent/cf-panel-agent 并 chmod +x
#      （构建见 agent/README.md，或从 GitHub Releases 下载全静态二进制）
#   2. 创建 /etc/cf-panel-agent.env：
#        AGENT_WSS_URL=wss://panel.example.com/ws/agent
#        AGENT_KEY=<你的 key>
#   3. 复制本文件到 /etc/systemd/system/cf-panel-agent.service
#   4. systemctl daemon-reload && systemctl enable --now cf-panel-agent
# 监控上报已内置（经控制 WS 上报，无需 crontab；间隔可改 REPORT_INTERVAL，默认 120s）
# 注：旧版 Shell agent（agent/shell/agent.sh）已废弃，改用本 Rust 二进制，环境变量完全一致

[Unit]
Description=cf-panel agent (Web Terminal + Monitor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/cf-panel-agent/cf-panel-agent
EnvironmentFile=/etc/cf-panel-agent.env
Restart=always
RestartSec=3
# 安全加固：
# - 默认以 root 运行（历史行为，保证文件管理可读写任意路径）。
#   强烈建议以专用低权限用户运行（agent 被攻破后不直接获得 root）：
#     useradd --system --home-dir /opt/cf-panel-agent --shell /usr/sbin/nologin cf-panel-agent
#     chown -R cf-panel-agent:cf-panel-agent /opt/cf-panel-agent
#   然后取消下面 User=/Group= 两行注释。
#   注意：低权限用户只能访问其有权限的文件路径（无法管理 /root 等）；
#   如需限制终端命令执行（bash -i），在 /etc/cf-panel-agent.env 中设置 DISABLE_EXEC=1。
# User=cf-panel-agent
# Group=cf-panel-agent
# - 文件管理特性需要写任意路径（上传/下载），因此不能用 ProtectSystem=strict / ProtectHome=true
#   （那会把整机文件系统只读、屏蔽 /home，导致文件管理不可用）；
#   折中使用 ProtectSystem=full（/usr /boot /etc 只读，/home /var /tmp 仍可写）
# - PrivateDevices 提供私有 /dev（含 ptmx/pts），终端 PTY 可正常工作
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
