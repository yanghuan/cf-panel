# cf-panel agent systemd 服务模板
# 用法：
#   1. 把 agent.sh 放到 /opt/cf-panel-agent/agent.sh 并 chmod +x
#   2. 创建 /etc/cf-panel-agent.env：
#        AGENT_WSS_URL=wss://panel.example.com/ws/agent
#        AGENT_KEY=<你的 key>
#   3. 复制本文件到 /etc/systemd/system/cf-panel-agent.service
#   4. systemctl daemon-reload && systemctl enable --now cf-panel-agent
# 监控上报已内置（agent.sh 经控制 WS 上报，无需 crontab；间隔可改 REPORT_INTERVAL，默认 120s）

[Unit]
Description=cf-panel agent (Web Terminal + Monitor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/cf-panel-agent/agent.sh
EnvironmentFile=/etc/cf-panel-agent.env
Restart=always
RestartSec=3
# 安全加固：
# - 文件管理特性需要写任意路径（上传/下载），因此不能用 ProtectSystem=strict / ProtectHome=true
#   （那会把整机文件系统只读、屏蔽 /home，导致文件管理不可用）；
#   折中使用 ProtectSystem=full（/usr /boot /etc 只读，/home /var /tmp 仍可写）
# - PrivateDevices 提供私有 /dev（含 ptmx/pts），终端 PTY（socat）可正常工作
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
